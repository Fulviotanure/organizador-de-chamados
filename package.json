{
  "name": "organizador-de-chamados",
  "version": "1.0.54",
  "description": "Chamados Conciliador Contábil",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node tests/test_tabs.js && node tests/test_drawer_integration.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "chamados",
    "demandas",
    "conciliador",
    "organizador"
  ],
  "author": "Fulvio Tanure",
  "license": "MIT",
  "build": {
    "appId": "com.conciliador.organizadorchamados",
    "productName": "Chamados Conciliador Contábil",
    "copyright": "Copyright © 2026 Fulvio Tanure",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Fulviotanure",
      "repo": "organizador-de-chamados",
      "releaseType": "draft"
    },
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Chamados Conciliador Contábil",
      "artifactName": "Chamados-Conciliador-Contabil-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
